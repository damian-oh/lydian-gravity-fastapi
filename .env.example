PROJECT_NAME="Lydian Gravity FastAPI"
DEBUG=True
DATABASE_URL="sqlite:///./your_sqlite_database.db"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Demo mode: auto-provision a throwaway account so visitors can explore without
# registering. Leave False for any deployment holding real user data.
DEMO_MODE=False
DEMO_SESSION_EXPIRE_MINUTES=720
DEMO_MAX_SESSIONS_PER_HOUR=60
